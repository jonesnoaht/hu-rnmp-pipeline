:false,"isInferred":true,"maxDepth":6,"name":["Cell Cycle Checkpoints"],"releaseDate":"2026-06-17","speciesName":"Drosophila melanogaster","inferredFrom":[69620],"hasDiagram":true,"hasEHLD":false,"schemaClass":"Pathway","className":"Pathway"},{"dbId":11114818,"displayName":"Cell Cycle Checkpoints","stId":"R-SCE-69620","stIdVersion":"R-SCE-69620.1","isInDisease":false,"isInferred":true,"maxDepth":5,"name":["Cell Cycle Checkpoints"],"releaseDate":"2026-06-17","speciesName":"Saccharomyces cerevisiae","inferredFrom":[69620],"hasDiagram":true,"hasEHLD":false,"schemaClass":"Pathway","className":"Pathway"},{"dbId":10654638,"displayName":"Cell Cycle Checkpoints","stId":"R-DRE-69620","stIdVersion":"R-DRE-69620.1","isInDisease":false,"isInferred":true,"maxDepth":7,"name":["Cell Cycle Checkpoints"],"releaseDate":"2026-06-17","speciesName":"Danio rerio","inferredFrom":[69620],"hasDiagram":true,"hasEHLD":false,"schemaClass":"Pathway","className":"Pathway"},{"dbId":10228194,"displayName":"Cell Cycle Checkpoints","stId":"R-RNO-69620","stIdVersion":"R-RNO-69620.1","isInDisease":false,"isInferred":true,"maxDepth":7,"name":["Cell Cycle Checkpoints"],"releaseDate":"2026-06-17","speciesName":"Rattus norvegicus","inferredFrom":[69620],"hasDiagram":true,"hasEHLD":false,"schemaClass":"Pathway","className":"Pathway"},{"dbId":10562513,"displayName":"Cell Cycle Checkpoints","stId":"R-SSC-69620","stIdVersion":"R-SSC-69620.1","isInDisease":false,"isInferred":true,"maxDepth":7,"name":["Cell Cycle Checkpoints"],"releaseDate":"2026-06-17","speciesName":"Sus scrofa","inferredFrom":[69620],"hasDiagram":true,"hasEHLD":false,"schemaClass":"Pathway","className":"Pathway"},{"dbId":11056936,"displayName":"Cell Cycle Checkpoints","stId":"R-DDI-69620","stIdVersion":"R-DDI-69620.1","isInDisease":false,"isInferred":true,"maxDepth":7,"name":["Cell Cycle Checkpoints"],"releaseDate":"2026-06-17","speciesName":"Dictyostelium discoideum","inferredFrom":[69620],"hasDiagram":true,"hasEHLD":false,"schemaClass":"Pathway","className":"Pathway"},{"dbId":10104426,"displayName":"Cell Cycle Checkpoints","stId":"R-MMU-69620","stIdVersion":"R-MMU-69620.1","isInDisease":false,"isInferred":true,"maxDepth":7,"name":["Cell Cycle Checkpoints"],"releaseDate":"2026-06-17","speciesName":"Mus musculus","inferredFrom":[69620],"hasDiagram":true,"hasEHLD":false,"schemaClass":"Pathway","className":"Pathway"}],"species":[{"dbId":48887,"displayName":"Homo sapiens","name":["Homo sapiens","H. sapiens","Hs","human","man"],"taxId":"9606","abbreviation":"HSA","className":"Species","schemaClass":"Species"}],"summation":[{"dbId":69621,"displayName":"<p>A hallmark of the human cell cycle in normal somatic cell...","text":"<p>A hallmark of the human cell cycle in normal somatic cells is its precision. This remarkable fidelity is achieved by a number of signal transduction pathways, known as checkpoints, which monitor cell cycle progression ensuring an interdependency of S phase and mitosis, the integrity of the genome and the fidelity of chromosome segregation (reviewed in Shackelford et al. 1999, Panagopoulos and Altmeyer 2021, Tyson and Novak 2022).</p><p>Checkpoints are layers of control that act to delay CDK activation when defects in the division program occur. As the CDKs functioning at different points in the cell cycle are regulated by different means, the various checkpoints differ in the biochemical mechanisms by which they elicit their effect. However, all checkpoints share a common hierarchy of a sensor, signal transducers, and effectors that interact with the CDKs (reviewed in Poon 2016).</p><p>Depending on the stage of the cell cycle that they regulate, the cell cycle checkpoints are divided into G1/S checkpoints, S phase checkpoints, G2/M checkpoints, and M/G1 checkpoints (reviewed in Poon 2016). Reactome currently has partial coverage of G1/S checkpoints (pathway G1/S DNA Damage Checkpoints), G2/M checkpoints (pathway G2/M Checkpoints), and M/G1 checkpoints (pathway Mitotic Spindle Checkpoint).</p><p>The stability of the genome in somatic cells contrasts to the almost universal genomic instability of tumor cells. There are a number of documented genetic lesions in checkpoint genes, or in cell cycle genes themselves, which result either directly in cancer or in a predisposition to certain cancer types. Indeed, restraint over cell cycle progression and failure to monitor genome integrity are likely prerequisites for the molecular evolution required for the development of a tumor. Perhaps most notable amongst these is the TP53 (p53) tumor suppressor gene, which is mutated in >50% of human tumors. Thus, the importance of the checkpoint pathways to human biology is clear (reviewed in Golubnitschaja 2007, Groelly et al. 2023).</p>","className":"Summation","schemaClass":"Summation"}],"reviewStatus":{"dbId":9821382,"displayName":"five stars","definition":"externally reviewed","name":["five stars"],"className":"ReviewStatus","schemaClass":"ReviewStatus"},"hasDiagram":true,"hasEHLD":false,"lastUpdatedDate":"2017-06-22","hasEvent":[{"dbId":69615,"displayName":"G1/S DNA Damage Checkpoints","stId":"R-HSA-69615","stIdVersion":"R-HSA-69615.5","isInDisease":false,"isInferred":false,"maxDepth":6,"name":["G1/S DNA Damage Checkpoints"],"releaseDate":"2004-07-06","speciesName":"Homo sapiens","eventOf":[69620],"doi":"10.3180/REACT_2254.1","hasDiagram":false,"hasEHLD":false,"lastUpdatedDate":"2017-06-22","schemaClass":"Pathway","className":"Pathway"},{"dbId":69481,"displayName":"G2/M Checkpoints","stId":"R-HSA-69481","stIdVersion":"R-HSA-69481.5","isInDisease":false,"isInferred":false,"maxDepth":4,"name":["G2/M Checkpoints"],"releaseDate":"2004-07-06","speciesName":"Homo sapiens","eventOf":[69620],"doi":"10.3180/REACT_828.2","hasDiagram":false,"hasEHLD":false,"lastUpdatedDate":"2021-09-15","schemaClass":"Pathway","className":"Pathway"},{"dbId":69618,"displayName":"Mitotic Spindle Checkpoint","stId":"R-HSA-69618","stIdVersion":"R-HSA-69618.4","isInDisease":false,"isInferred":false,"maxDepth":4,"name":["Mitotic Spindle Checkpoint"],"releaseDate":"2004-07-06","speciesName":"Homo sapiens","eventOf":[69620],"doi":"10.3180/REACT_2137.1","hasDiagram":false,"hasEHLD":false,"lastUpdatedDate":"2017-06-22","schemaClass":"Pathway","className":"Pathway"}],"schemaClass":"Pathway","className":"Pathway"}