73884","stIdVersion":"R-CFA-73884.1","isInDisease":false,"isInferred":true,"maxDepth":5,"name":["Base Excision Repair"],"releaseDate":"2026-06-17","speciesName":"Canis familiaris","inferredFrom":[73884],"hasDiagram":true,"hasEHLD":false,"schemaClass":"Pathway","className":"Pathway"},{"dbId":10228410,"displayName":"Base Excision Repair","stId":"R-RNO-73884","stIdVersion":"R-RNO-73884.1","isInDisease":false,"isInferred":true,"maxDepth":5,"name":["Base Excision Repair"],"releaseDate":"2026-06-17","speciesName":"Rattus norvegicus","inferredFrom":[73884],"hasDiagram":true,"hasEHLD":false,"schemaClass":"Pathway","className":"Pathway"},{"dbId":10104634,"displayName":"Base Excision Repair","stId":"R-MMU-73884","stIdVersion":"R-MMU-73884.1","isInDisease":false,"isInferred":true,"maxDepth":5,"name":["Base Excision Repair"],"releaseDate":"2026-06-17","speciesName":"Mus musculus","inferredFrom":[73884],"hasDiagram":true,"hasEHLD":false,"schemaClass":"Pathway","className":"Pathway"}],"species":[{"dbId":48887,"displayName":"Homo sapiens","name":["Homo sapiens","H. sapiens","Hs","human","man"],"taxId":"9606","abbreviation":"HSA","className":"Species","schemaClass":"Species"}],"summation":[{"dbId":73968,"displayName":"Of the three major pathways involved in the repair of nucleo...","text":"Of the three major pathways involved in the repair of nucleotide damage in DNA, base excision repair (BER) involves the greatest number of individual enzymatic activities. This is the consequence of the numerous individual glycosylases, each of which recognizes and removes a specific modified base(s) from DNA. BER is responsible for the repair of the most prevalent types of DNA lesions, oxidatively damaged DNA bases, which arise as a consequence of reactive oxygen species generated by normal mitochondrial metabolism or by oxidative free radicals resulting from ionizing radiation, lipid peroxidation or activated phagocytic cells. BER is a two-step process initiated by one of the DNA glycosylases that recognizes a specific modified base(s) and removes that base through the catalytic cleavage of the glycosydic bond, leaving an abasic site without disruption of the phosphate-sugar DNA backbone. Subsequently, abasic sites are resolved by a series of enzymes that cleave the backbone, insert the replacement residue(s), and ligate the DNA strand. BER may occur by either a single-nucleotide replacement pathway or a multiple-nucleotide patch replacement pathway, depending on the structure of the terminal sugar phosphate residue. The glycosylases found in human cells recognize \"foreign adducts\" and not standard functional modifications such as DNA methylation (Lindahl and Wood 1999, Sokhansanj et al. 2002).","className":"Summation","schemaClass":"Summation"}],"reviewStatus":{"dbId":9821382,"displayName":"five stars","definition":"externally reviewed","name":["five stars"],"className":"ReviewStatus","schemaClass":"ReviewStatus"},"doi":"10.3180/REACT_1104.3","hasDiagram":true,"hasEHLD":true,"lastUpdatedDate":"2021-09-15","hasEvent":[{"dbId":73929,"displayName":"Base-Excision Repair, AP Site Formation","stId":"R-HSA-73929","stIdVersion":"R-HSA-73929.5","isInDisease":false,"isInferred":false,"maxDepth":4,"name":["Base-Excision Repair, AP Site Formation"],"releaseDate":"2004-03-06","speciesName":"Homo sapiens","eventOf":[73884],"hasDiagram":true,"hasEHLD":false,"lastUpdatedDate":"2021-09-15","schemaClass":"Pathway","className":"Pathway"},{"dbId":73933,"displayName":"Resolution of Abasic Sites (AP sites)","stId":"R-HSA-73933","stIdVersion":"R-HSA-73933.4","isInDisease":false,"isInferred":false,"maxDepth":4,"name":["Resolution of Abasic Sites (AP sites)"],"releaseDate":"2004-03-06","speciesName":"Homo sapiens","eventOf":[73884],"hasDiagram":true,"hasEHLD":false,"lastUpdatedDate":"2018-06-13","schemaClass":"Pathway","className":"Pathway"}],"schemaClass":"Pathway","className":"Pathway"}