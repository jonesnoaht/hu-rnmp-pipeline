Excision Repair (GG-NER)"],"releaseDate":"2026-06-17","speciesName":"Canis familiaris","inferredFrom":[5696399],"hasDiagram":false,"hasEHLD":false,"schemaClass":"Pathway","className":"Pathway"},{"dbId":10228642,"displayName":"Global Genome Nucleotide Excision Repair (GG-NER)","stId":"R-RNO-5696399","stIdVersion":"R-RNO-5696399.1","isInDisease":false,"isInferred":true,"maxDepth":3,"name":["Global Genome Nucleotide Excision Repair (GG-NER)"],"releaseDate":"2026-06-17","speciesName":"Rattus norvegicus","inferredFrom":[5696399],"hasDiagram":false,"hasEHLD":false,"schemaClass":"Pathway","className":"Pathway"},{"dbId":10104866,"displayName":"Global Genome Nucleotide Excision Repair (GG-NER)","stId":"R-MMU-5696399","stIdVersion":"R-MMU-5696399.1","isInDisease":false,"isInferred":true,"maxDepth":3,"name":["Global Genome Nucleotide Excision Repair (GG-NER)"],"releaseDate":"2026-06-17","speciesName":"Mus musculus","inferredFrom":[5696399],"hasDiagram":false,"hasEHLD":false,"schemaClass":"Pathway","className":"Pathway"}],"species":[{"dbId":48887,"displayName":"Homo sapiens","name":["Homo sapiens","H. sapiens","Hs","human","man"],"taxId":"9606","abbreviation":"HSA","className":"Species","schemaClass":"Species"}],"summation":[{"dbId":6782734,"displayName":"The DNA damage in GG-NER is recognized by the joint action o...","text":"The DNA damage in GG-NER is recognized by the joint action of two protein complexes. The first complex is composed of XPC, RAD23A or RAD23B and CETN2. The second complex, known as the UV-DDB complex, is an ubiquitin ligase composed of DDB1, CUL4A or CUL4B, RBX1 and a GG-NER specific protein DDB2. In vitro, the UV-DDB complex is onlynecessary for GG-NER mediated repair of UV-induced pyrimidine dimers. In vivo, however, where DNA repair occurs in the chromatin context, the UV-DDB complex likely facilitates GG-NER mediated repair irrespective of the DNA damage type.<BR>After DNA damage recognition, the TFIIH complex, together with XPA, verifies the DNA damage and unwinds the DNA helix around the damage, creating an open bubble. Two DNA endonucleases, ERCC5 (XPG) and the complex of ERCC1 and ERCC4 (XPF), excise the oligonucleotide that contains damaged base(s) from the affected DNA strand. DNA polymerases delta, epsilon and/or kappa perform DNA repair synthesis, followed by DNA ligation, thus completing GG-NER.<BR>For a recent review, please refer to Marteijn et al. 2014.","className":"Summation","schemaClass":"Summation"}],"reviewStatus":{"dbId":9821382,"displayName":"five stars","definition":"externally reviewed","name":["five stars"],"className":"ReviewStatus","schemaClass":"ReviewStatus"},"hasDiagram":false,"hasEHLD":false,"hasEvent":[{"dbId":5696394,"displayName":"DNA Damage Recognition in GG-NER","stId":"R-HSA-5696394","stIdVersion":"R-HSA-5696394.2","isInDisease":false,"isInferred":false,"maxDepth":2,"name":["DNA Damage Recognition in GG-NER"],"releaseDate":"2004-03-06","speciesName":"Homo sapiens","eventOf":[5696399],"hasDiagram":false,"hasEHLD":false,"schemaClass":"Pathway","className":"Pathway"},{"dbId":5696395,"displayName":"Formation of Incision Complex in GG-NER","stId":"R-HSA-5696395","stIdVersion":"R-HSA-5696395.2","isInDisease":false,"isInferred":false,"maxDepth":2,"name":["Formation of Incision Complex in GG-NER"],"releaseDate":"2004-03-06","speciesName":"Homo sapiens","eventOf":[5696399],"hasDiagram":false,"hasEHLD":false,"schemaClass":"Pathway","className":"Pathway"},{"dbId":5696400,"displayName":"Dual Incision in GG-NER","stId":"R-HSA-5696400","stIdVersion":"R-HSA-5696400.3","isInDisease":false,"isInferred":false,"maxDepth":2,"name":["Dual Incision in GG-NER"],"releaseDate":"2004-03-06","speciesName":"Homo sapiens","eventOf":[5696399],"hasDiagram":false,"hasEHLD":false,"schemaClass":"Pathway","className":"Pathway"},{"dbId":5696397,"displayName":"Gap-filling DNA repair synthesis and ligation in GG-NER","stId":"R-HSA-5696397","stIdVersion":"R-HSA-5696397.3","isInDisease":false,"isInferred":false,"maxDe