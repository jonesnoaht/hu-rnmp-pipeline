profiles {
    docker {
        docker.enabled = true
        docker.fixOwnership = true
        process.container = 'hu-rnmp-pipeline:dev'
        params.tool_scripts = '/app/scripts'
    }
    local {
        docker.enabled = false
    }
    test {
        params.input_csv = "${projectDir}/../samples_test.csv"
        params.genome = 'sacCer3'
        params.max_reads = 50000
        params.subsample_seed = 1
        params.run_harmonia = false
        params.enable_pathway_ora = false
        params.outdir = 'results/test'
        params.min_mapq = 0
        process {
            cpus = 2
            memory = '2.GB'
            time = '2.h'
        }
    }
    // Not a working Kubernetes profile. Cluster manifests are maintained separately.
    k8s {
        k8s {
            cliPath = '/usr/local/bin/nextflow'
        }
        process.container = 'ghcr.io/jonesnoaht/hu-rnmp-pipeline:latest'
    }
}

process {
    shell = ['/bin/bash', '-euo', 'pipefail']
    cpus = 2
    memory = '2.GB'
    time = '2.h'
    publishDir = [
        path: { "${params.outdir}/${task.process.replaceAll('[:/]', '_')}" },
        mode: 'copy'
    ]
}
