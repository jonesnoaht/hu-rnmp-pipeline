// nextflow/conf/base.config

// Default profiles: local docker
profiles {
    docker {
        docker.enabled = true
        process.container = 'hu-rnmp-pipeline:dev'
    }
    local {
        // Bare-metal runs; tools on PATH
    }
    k8s {
        k8s {
            cliPath = '/usr/local/bin/nextflow'
        }
        process.container = 'ghcr.io/jonesnoaht/hu-rnmp-pipeline:latest'
    }
}

// Default process resources
process {
    memory = '4.GB'
    cpu = 2
    time = '2.h'

    // Publish all results to workdir
    publishDir = "${params.workdir_result}/${task.process.replaceAll('[:/]', '_')}",
        mode: 'copy'
}

// SRA fetch settings
params {
    sra_thread_count = 4
    sra_prefetch_dir = "${params.workdir_result}/sra_cache"
}
